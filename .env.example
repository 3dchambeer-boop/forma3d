# FORMA·3D environment. Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32
# Integrations left empty are disabled and reported as "not configured"; nothing is simulated.

# ── Core (required) ──────────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL="file:../db/custom.db"   # relative to prisma/; Docker sets an absolute path
PUBLIC_BASE_URL=https://forma.example.com
SESSION_SECRET=                 # >= 32 chars
DOWNLOAD_SIGNING_SECRET=        # >= 32 chars, signs model / G-code download links
STORAGE_DIR=./storage           # private files (STL, GLB, G-code); outside public/
SIGNUP_ORG_SLUG=                # optional: organization new customers join

# ── First administrator (scripts/create-admin.ts or prisma/seed.ts) ──────────
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=                 # strong password; only the bcrypt hash is stored. Remove after first run.
# prisma/seed.ts (organization + admin; idempotent)
SEED_ORG_NAME=CMG
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=            # >= 12 chars
SEED_DEMO_USERS=0               # 1 = create demo accounts (development only)

# ── Internal services ────────────────────────────────────────────────────────
ENGINE_URL=http://127.0.0.1:8100
ENGINE_SERVICE_TOKEN=           # shared with services/ai_3d_engine
CAD_ENGINE_URL=http://127.0.0.1:8200
CAD_SERVICE_TOKEN=              # shared with services/cad_engine
NOTIFY_DISPATCH_TOKEN=          # protects /api/notifications/dispatch (cron)

# ── AI designer (Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_DESIGNER_MODEL_QUICK=claude-haiku-5-5
AI_DESIGNER_MODEL_DEFAULT=claude-sonnet-5-5
AI_DESIGNER_MODEL_COMPLEX=claude-opus-5-5
AI_PRICING_JSON=                # {"claude-sonnet-5-5":{"input":..,"output":..}} USD per Mtok
AI_MONTHLY_BUDGET_USD=          # stop new AI calls once reached
AI_USAGE_LOG=./logs/ai-usage.jsonl

# ── Generation providers / worker ────────────────────────────────────────────
GENERATION_FREEFORM_PROVIDER=   # TRIPO | MESHY | RODIN | SELF_HOSTED
GENERATION_FALLBACKS=
GENERATION_RATE_LIMIT_PER_HOUR=20
GENERATION_MAX_ACTIVE_PER_USER=2
WORKER_IDLE_MS=2000
ENABLE_MOCK_PROVIDER=0          # never 1 in production
TRIPO_API_KEY=
MESHY_API_KEY=
MESHY_AI_MODEL=
RODIN_API_KEY=
RODIN_TIER=
SELF_HOSTED_INFERENCE_URL=
SELF_HOSTED_INFERENCE_TOKEN=

# ── Google sign-in ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://forma.example.com/api/auth/google/callback

# ── Payments (Iraq) ──────────────────────────────────────────────────────────
ZAINCASH_BASE_URL=
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
ZAINCASH_API_KEY=
ZAINCASH_SERVICE_TYPE=
FIB_BASE_URL=
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=

# ── Notifications ────────────────────────────────────────────────────────────
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Slicing / printing ───────────────────────────────────────────────────────
ORCASLICER_BIN=
ORCASLICER_PROFILE_DIR=
ORCASLICER_TIMEOUT_MS=300000
# OctoPrint: each printer row stores its URL and the NAME of the env var holding its API key, e.g.
# PRINTER_1_OCTOPRINT_KEY=
